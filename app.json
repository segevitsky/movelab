{
  "expo": {
    "name": "MoveLab",
    "slug": "movelab",
    "version": "0.0.1",
    "scheme": "movelab",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.segev.movelab",
      "supportsTablet": false,
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Not used. Required by iOS when screen recording is available.",
        "NSPhotoLibraryUsageDescription": "Pick a screen recording of a reel to turn it into an exercise.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "AUT5N398FP"
    },
    "android": {
      "package": "com.segev.movelab",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [],
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-asset",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.segev.movelab",
            "activationRule": {
              "supportsWebUrlWithMaxCount": 1,
              "supportsText": true,
              "supportsMovieWithMaxCount": 1
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a screen recording of a reel to turn it into an exercise.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "networkInspector": false
          }
        }
      ],
      "expo-sqlite",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0e1014",
          "imageWidth": 260
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
