{
  "expo": {
    "name": "MoveLab",
    "slug": "movelab",
    "version": "0.0.1",
    "scheme": "movelab",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.segev.movelab",
      "supportsTablet": false,
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Needed by iOS to record a video with the camera. Audio is not analysed or kept.",
        "NSPhotoLibraryUsageDescription": "Pick a screen recording of a reel to turn it into an exercise.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSCameraUsageDescription": "Record yourself doing an exercise to turn it into a card. The video is deleted after processing.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "MoveLab workout",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.segev.movelab.workout"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.segev.movelab.workout",
            "UTTypeDescription": "MoveLab workout",
            "UTTypeConformsTo": [
              "public.json",
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "movelab"
              ],
              "public.mime-type": [
                "application/vnd.movelab.workout+json"
              ]
            }
          }
        ]
      },
      "appleTeamId": "AUT5N398FP"
    },
    "android": {
      "package": "com.segev.movelab",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [],
      "softwareKeyboardLayoutMode": "pan",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/vnd.movelab.workout+json"
            },
            {
              "scheme": "content",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\.movelab"
            },
            {
              "scheme": "content",
              "mimeType": "application/json",
              "pathPattern": ".*\\.movelab"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.movelab"
            },
            {
              "scheme": "content",
              "mimeType": "application/octet-stream"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-asset",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.segev.movelab",
            "activationRule": {
              "supportsWebUrlWithMaxCount": 1,
              "supportsText": true,
              "supportsMovieWithMaxCount": 1
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a screen recording of a reel to turn it into an exercise.",
          "cameraPermission": "Record yourself doing an exercise to turn it into a card.",
          "microphonePermission": "Needed by iOS to record a video with the camera. Audio is not kept."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "networkInspector": false
          }
        }
      ],
      "expo-sqlite",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0e1014",
          "imageWidth": 260
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
